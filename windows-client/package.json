{
  "name": "bravorobots-escritorio-remoto",
  "version": "1.0.0",
  "description": "Cliente de escritorio Windows para Escritorio Remoto Bravo Robots",
  "main": "main.js",
  "author": "niki <niki.tecnico@gmail.com>",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "build:windows": "electron-packager . Escritorio-Remoto-Bravo --platform=win32 --arch=x64 --out=../artifacts --overwrite --asar --prune=true",
    "build:linux": "electron-packager . Escritorio-Remoto-Bravo --platform=linux --arch=x64 --out=../artifacts --overwrite --asar --prune=true"
  },
  "devDependencies": {
    "@electron/packager": "^18.3.6",
    "electron": "^38.3.0"
  }
}
